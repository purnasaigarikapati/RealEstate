# EstateHub Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your local or Atlas URI)
# If MongoDB is not running locally, EstateHub runs in resilient fallback mode with sample data
MONGODB_URI=mongodb://localhost:27017/estatehub

# JWT Secret Key for Session Authentication
JWT_SECRET=estatehub_super_secret_jwt_key_2025_secure

# Client URL for CORS
CLIENT_URL=http://localhost:5173

